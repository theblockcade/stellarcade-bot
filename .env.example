# Must include the backend's /api mount prefix — ArcadeApiClient appends
# paths like /leaderboard directly to this base, and the stellarcade
# backend serves those under /api (e.g. /api/leaderboard), not at its root.
GATEWAY_URL=https://gateway.testnet.stellarcade.xyz/api
ARBITER_URL=https://arbiter.testnet.stellarcade.xyz
WEB_APP_URL=https://stellarcade.xyz

# At least one of these two is required.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

LINK_STORE_PATH=./data/links.json
NODE_ENV=development
LOG_LEVEL=info
